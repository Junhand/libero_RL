+    def _apply_offset_scores(self, replay_trajectories: list[Trajectory], seqs: list[list[int]]) -> None:
+        """Replace/augment each transition's reward by the temporal-offset score of its RL tokens.
+
+        sft:    score_t = f(z_t, z_{t+s}) * L / s, s = min(L, steps left in the episode); the last transition
+                (no later observation is stored) takes the previous score. Stored in ``rewards`` (read by the SFT loss).
+        reward: r_t = reward_scale * f(z_t, z_{t+1}) / L_max (progress made by the chunk); the last transition
+                takes the previous value. ``reward_mode`` = "replace" or "add" (to the environment reward).
+        """
+        cfg = self._offset_cfg()
+        if getattr(self, "_offset_scorer", None) is None:
+            self._offset_scorer = OffsetScorer(str(cfg.ckpt), torch.device(self.device))
+        scorer = self._offset_scorer
+        mode = self._offset_mode()
+        look = int(cfg.get("lookahead", 3))
+        scale = float(cfg.get("reward_scale", 1.0))
+        add = str(cfg.get("reward_mode", "replace")) == "add"
+        for seq in seqs:
+            n = len(seq)
+            if n == 0:
+                continue
+            z = torch.cat([replay_trajectories[p].curr_obs["z_rl"].reshape(1, -1) for p in seq], dim=0)
+            values = [0.0] * n
+            if n > 1:
+                if mode == "sft":
+                    steps = [min(look, n - 1 - p) for p in range(n - 1)]
+                    a = z[: n - 1]
+                    b = torch.stack([z[p + steps[p]] for p in range(n - 1)])
+                    out = scorer(a, b)
+                    for p in range(n - 1):
+                        values[p] = float(out[p]) * look / steps[p]
+                else:
+                    out = scorer(z[:-1], z[1:])
+                    for p in range(n - 1):
+                        values[p] = scale * float(out[p]) / scorer.lmax
+                values[n - 1] = values[n - 2]
+            for p, v in zip(seq, values):
+                tr = replay_trajectories[p]
+                if mode == "sft":
+                    tr.rewards = torch.full_like(tr.rewards, v)
+                elif add:
+                    tr.rewards = tr.rewards.clone()
+                    tr.rewards[..., 0] += v
+                else:
+                    r = torch.zeros_like(tr.rewards)
+                    r[..., 0] = v
+                    tr.rewards = r
+
