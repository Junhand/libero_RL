 @torch.no_grad()
+def _resume_state_path(resume_dir, dataset_cfg: dict) -> Path | None:
+    """Phase-1 checkpoint file for a dataset, or None when resume is disabled."""
+    if not resume_dir:
+        return None
+    name = Path(dataset_cfg.get("dataset_path", "")).name or "dataset"
+    return Path(resume_dir) / f"phase1_{name}.npz"
+
+
+def _resume_fingerprint(cfg, dataset_cfg: dict, extended_size, shard_start, ret_min, ret_max) -> str:
+    """Identifies the inputs a Phase-1 checkpoint is valid for."""
+    return json.dumps(
+        {
+            "dataset": str(dataset_cfg.get("dataset_path", "")),
+            "value_checkpoint": str(cfg.advantage.value_checkpoint),
+            "returns_tag": str(cfg.advantage.get("returns_tag", None)),
+            "extended_size": int(extended_size),
+            "shard_start": int(shard_start),
+            "ret_min": float(ret_min),
+            "ret_max": float(ret_max),
+        },
+        sort_keys=True,
+    )
+
+
+def _save_resume_state(path: Path, fingerprint: str, arrays: dict) -> None:
+    """Atomically write the Phase-1 arrays (tmp file + rename)."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + ".tmp.npz")
+    np.savez(tmp, fingerprint=np.array(fingerprint), **arrays)
+    os.replace(tmp, path)
+
+
