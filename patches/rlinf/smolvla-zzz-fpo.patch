+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""SmolVLA for vanilla Flow Policy Optimization (FPO, arXiv:2507.21053) in RLinf's embodied PPO.
+
+Mapping onto RLinf's PPO (``loss_type: actor_critic``, ``logprob_type: token_level``):
+  * ``logprobs``     = ``-sum_h mean_n CFM loss`` of ``N`` fixed (time, noise) samples over the ``H`` executed
+                       action steps, ``[B, 1]``. ``old_logprobs`` come from the rollout (same weights, same fixed
+                       samples), so there is one ratio ``exp(sum_h mean_n (L_old - L_new))`` per action chunk, as in
+                       verl-vla's FPO (``training_worker.py``).
+  * ``values``       = MLP value head over the mean-pooled final-layer VLM prefix and the robot state.
+  * trainable        = action expert, action input/output projections and time MLP, value head. The VLM
+                       (including ``state_proj``, which is part of the prefix) is frozen.
+The whole policy runs in fp32: in bf16 the CFM loss has a noise floor (~4e-3) comparable to FPO's clip radius.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Literal
+
+import torch
+from torch import nn
+
+from rlinf.models.embodiment.base_policy import ForwardType
+from rlinf.models.embodiment.pi0_fast.lerobot_io import build_lerobot_batch_from_env_obs
+from rlinf.models.embodiment.smolvla.fpo import smolvla_fpo_cfm_loss
+from rlinf.models.embodiment.smolvla.smolvla_action_model import (
+    SmolVLAForRLActionPrediction,
+)
+
+
+class SmolVLAForFPO(SmolVLAForRLActionPrediction):
+    def __init__(
+        self,
+        policy: nn.Module,
+        *,
+        n_action_samples: int = 4,
+        value_hidden_dims: tuple[int, ...] = (512, 256),
+        state_dim: int = 8,
+        **kwargs: Any,
+    ) -> None:
+        super().__init__(policy, **kwargs)
+        self.n_action_samples = int(n_action_samples)
+        self.policy.float()
+        model = self.policy.model
+        config = self.policy.config
+        d_model = int(model.vlm_with_expert.config.text_config.hidden_size)
+        # The robot state fed to the value head is the (normalised) env proprioception, 8-d in LIBERO
+        # (the checkpoint's `robot_state_feature` says 6).
+        state_dim = int(state_dim)
+        dims = [d_model + state_dim, *[int(d) for d in value_hidden_dims]]
+        layers: list[nn.Module] = []
+        for d_in, d_out in zip(dims[:-1], dims[1:]):
+            layers += [nn.Linear(d_in, d_out), nn.ReLU()]
+        layers.append(nn.Linear(dims[-1], 1))
+        self.value_head = nn.Sequential(*layers)  # the name selects the value learning rate
+
+        for parameter in self.policy.parameters():
+            parameter.requires_grad = False
+        trainable = [
+            model.vlm_with_expert.lm_expert,
+            model.action_in_proj,
+            model.action_out_proj,
+            model.action_time_mlp_in,
+            model.action_time_mlp_out,
+        ]
+        for module in trainable:
+            for parameter in module.parameters():
+                parameter.requires_grad = True
+
+    @staticmethod
+    def _chunk_logprob(loss: torch.Tensor) -> torch.Tensor:
+        """[B, H, N] CFM losses -> [B, 1] chunk log-likelihood surrogate (sum over steps, mean over samples)."""
+        return (-loss.sum(dim=1).mean(dim=-1)).unsqueeze(-1).float()
+
+    # ------------------------------------------------------------------ inputs
+    def _model_inputs(self, batch: dict[str, Any]):
+        from lerobot.utils.constants import (
+            OBS_LANGUAGE_ATTENTION_MASK,
+            OBS_LANGUAGE_TOKENS,
+        )
+
+        images, img_masks = self.policy.prepare_images(batch)
+        state = self.policy.prepare_state(batch)
+        return images, img_masks, batch[OBS_LANGUAGE_TOKENS], batch[OBS_LANGUAGE_ATTENTION_MASK], state
+
+    def _value(self, features: torch.Tensor, batch: dict[str, Any]) -> torch.Tensor:
+        state = batch["observation.state"].to(features.dtype)
+        return self.value_head(torch.cat([features, state], dim=-1)).squeeze(-1).float()
+
+    # ----------------------------------------------------------------- rollout
+    @torch.no_grad()
+    def predict_action_batch(
+        self,
+        env_obs: dict[str, Any],
+        mode: Literal["train", "eval"] = "train",
+        **kwargs: Any,
+    ) -> tuple[torch.Tensor, dict[str, Any]]:
+        if mode == "eval":
+            return super().predict_action_batch(env_obs, mode=mode, **kwargs)
+        from lerobot.utils.constants import (
+            OBS_LANGUAGE_ATTENTION_MASK,
+            OBS_LANGUAGE_TOKENS,
+        )
+
+        batch = build_lerobot_batch_from_env_obs(env_obs, image_size=self.image_size)
+        batch = self._prepare_lerobot_batch(batch)
+        config = self.policy.config
+        chunk, max_dim = int(config.chunk_size), int(config.max_action_dim)
+        normalized = self.policy.predict_action_chunk(batch, noise=self._sample_noise(batch))  # [B, chunk, action_dim]
+        batch_size = normalized.shape[0]
+        act_pad = torch.zeros(batch_size, chunk, max_dim, device=normalized.device, dtype=torch.float32)
+        act_pad[:, :, : self.action_dim] = normalized[:, :chunk, : self.action_dim].float()
+
+        num_steps, n = self.num_action_chunks, self.n_action_samples
+        timesteps = torch.rand(batch_size, n, device=act_pad.device)
+        noise = torch.randn(batch_size, n, chunk, max_dim, device=act_pad.device)
+        images, img_masks, lang_tokens, lang_masks, state = self._model_inputs(batch)
+        loss, features = smolvla_fpo_cfm_loss(
+            self.policy.model, images, img_masks, lang_tokens, lang_masks, state, act_pad, timesteps, noise,
+            action_dim=self.action_dim, num_steps=num_steps, return_features=True,
+        )
+        prev_logprobs = self._chunk_logprob(loss).cpu()
+        prev_values = self._value(features, batch).reshape(batch_size, 1).cpu()
+
+        actions = normalized[:, :num_steps, : self.action_dim].float().cpu()
+        if self.postprocessor is not None:
+            actions = self.postprocessor(actions)
+        forward_inputs = {
+            "main_images": env_obs["main_images"].cpu(),
+            "wrist_images": env_obs["wrist_images"].cpu(),
+            "states": env_obs["states"].float().cpu(),
+            "lang_tokens": batch[OBS_LANGUAGE_TOKENS].cpu(),
+            "lang_masks": batch[OBS_LANGUAGE_ATTENTION_MASK].cpu(),
+            "act_pad": act_pad.reshape(batch_size, -1).cpu(),
+            "fpo_timesteps": timesteps.cpu(),
+            "fpo_noise": noise.cpu(),
+            "action": actions.reshape(batch_size, -1).float(),
+        }
+        return actions, {
+            "prev_logprobs": prev_logprobs,
+            "prev_values": prev_values,
+            "forward_inputs": forward_inputs,
+        }
+
+    # ---------------------------------------------------------------- training
+    def forward(self, forward_type=ForwardType.DEFAULT, **kwargs):
+        if forward_type == ForwardType.DEFAULT:
+            return self.default_forward(**kwargs)
+        return super().forward(forward_type, **kwargs)
+
+    def default_forward(self, forward_inputs: dict[str, torch.Tensor], **kwargs: Any) -> dict[str, torch.Tensor]:
+        """Recompute ``logprobs`` (= -CFM loss of the stored samples) and ``values`` for the stored rollout."""
+        from lerobot.utils.constants import (
+            OBS_LANGUAGE_ATTENTION_MASK,
+            OBS_LANGUAGE_TOKENS,
+        )
+
+        device = next(self.parameters()).device
+        batch_size = forward_inputs["states"].shape[0]
+        obs = {
+            "main_images": forward_inputs["main_images"],
+            "wrist_images": forward_inputs["wrist_images"],
+            "states": forward_inputs["states"],
+            "task_descriptions": [""] * batch_size,  # tokens are restored from the rollout below
+        }
+        batch = self._prepare_lerobot_batch(build_lerobot_batch_from_env_obs(obs, image_size=self.image_size))
+        batch[OBS_LANGUAGE_TOKENS] = forward_inputs["lang_tokens"].to(device)
+        batch[OBS_LANGUAGE_ATTENTION_MASK] = forward_inputs["lang_masks"].to(device)
+        config = self.policy.config
+        chunk, max_dim = int(config.chunk_size), int(config.max_action_dim)
+        act_pad = forward_inputs["act_pad"].to(device).reshape(batch_size, chunk, max_dim).float()
+        timesteps = forward_inputs["fpo_timesteps"].to(device).float()
+        noise = forward_inputs["fpo_noise"].to(device).float()
+        images, img_masks, lang_tokens, lang_masks, state = self._model_inputs(batch)
+        loss, features = smolvla_fpo_cfm_loss(
+            self.policy.model, images, img_masks, lang_tokens, lang_masks, state, act_pad, timesteps, noise,
+            action_dim=self.action_dim, num_steps=self.num_action_chunks, return_features=True,
+        )
+        return {
+            "logprobs": self._chunk_logprob(loss),
+            "values": self._value(features, batch),
+            "entropy": torch.zeros(batch_size, 1, device=device, dtype=torch.float32),
+        }
