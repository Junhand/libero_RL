+
+    @torch.no_grad()
+    def decode_with_noise(self, noise: torch.Tensor) -> torch.Tensor:
+        """Decode steered initial noise into env actions (DSRL).
+
+        ``noise`` is ``[B, C, D]`` (the first C steps of the flow-matching noise, D = the VLA's noise dim); the
+        remaining steps of the chunk get fresh N(0, I) noise. Must follow ``extract_rlt_obs`` of the same
+        observation (it reuses the prepared batch). Returns ``[B, ref_num_action_chunks, action_dim]``.
+        """
+        batch = self._last_batch
+        cfg = self.policy.config
+        device = next(self.policy.parameters()).device
+        bsz = noise.shape[0]
+        full = torch.randn(bsz, cfg.chunk_size, cfg.max_action_dim, device=device)
+        c = min(noise.shape[1], cfg.chunk_size)
+        full[:, :c, : noise.shape[2]] = noise[:, :c].to(device=device, dtype=full.dtype)
+        actions = self.policy.predict_action_chunk(batch, noise=full)
+        actions = actions[:, : self.ref_num_action_chunks, : self.action_dim].float().cpu()
+        if self.postprocessor is not None:
+            actions = self.postprocessor(actions)
+        return actions.to(device=noise.device, dtype=torch.float32)
