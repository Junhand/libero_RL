+"""Frozen SmolVLA + RL token for RLT Stage 2.
+
+``extract_rlt_obs`` returns the three tensors the Stage-2 actor-critic consumes
+(``RLT_OBS_KEYS``): the RL token ``z_rl``, the raw proprioception and the VLA
+reference action chunk. The RL token is the single token an
+``RLTTokenTransformer`` encoder produces from the image-token hidden states of
+SmolVLA's prefix pass (language and state tokens are excluded; the task
+instruction is fixed). The encoder is trained offline (Stage 1) on those
+hidden states divided by one global scale.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import torch
+
+from rlinf.models.embodiment.modules.rlt_token_transformer import RLTTokenTransformer
+from rlinf.models.embodiment.pi0_fast.lerobot_io import build_lerobot_batch_from_env_obs
+from rlinf.models.embodiment.smolvla.smolvla_action_model import (
+    SmolVLAForRLActionPrediction,
+)
+
+
+class SmolVLARLTFeatureModel(SmolVLAForRLActionPrediction):
+    """SmolVLA that also exposes the RL token (frozen feature extractor)."""
+
+    def __init__(
+        self,
+        policy: torch.nn.Module,
+        *,
+        rlt_token_ckpt: str,
+        ref_num_action_chunks: int,
+        rlt_num_image_tokens: int = 128,
+        rlt_num_layers: int = 2,
+        rlt_num_heads: int = 8,
+        **kwargs: Any,
+    ) -> None:
+        super().__init__(policy, **kwargs)
+        self.ref_num_action_chunks = int(ref_num_action_chunks)
+        self.rlt_num_image_tokens = int(rlt_num_image_tokens)
+        ckpt = torch.load(rlt_token_ckpt, map_location="cpu")
+        state_dict = ckpt["net"]
+        hidden = int(policy.model.vlm_with_expert.config.text_config.hidden_size)
+        self.rlt_module = RLTTokenTransformer(
+            input_dim=hidden,
+            embed_dim=hidden,
+            prefix_seq_len=self.rlt_num_image_tokens,
+            num_layers=rlt_num_layers,
+            num_heads=rlt_num_heads,
+        )
+        self.rlt_module.load_state_dict(state_dict)
+        self.rlt_module.eval().requires_grad_(False)
+        self.rlt_scale = float(ckpt["scale"])
+
+    @property
+    def z_dim(self) -> int:
+        return self.rlt_module.z_dim
+
+    def _prefix_hidden(self, batch: dict[str, Any]) -> torch.Tensor:
+        """Final-layer VLM hidden states of the image tokens, ``[B, M, D]``."""
+        from lerobot.policies.smolvla.modeling_smolvla import make_att_2d_masks
+
+        policy = self.policy
+        model = policy.model
+        images, image_masks = policy.prepare_images(batch)
+        state = policy.prepare_state(batch)
+        embs, pad, att = model.embed_prefix(
+            images,
+            image_masks,
+            batch["observation.language.tokens"],
+            batch["observation.language.attention_mask"],
+            state=state,
+        )
+        out, _ = model.vlm_with_expert.forward(
+            attention_mask=make_att_2d_masks(pad, att),
+            position_ids=torch.cumsum(pad, dim=1) - 1,
+            past_key_values=None,
+            inputs_embeds=[embs, None],
+            use_cache=True,
+        )
+        return out[0][:, : self.rlt_num_image_tokens].float()
+
+    @torch.no_grad()
+    def extract_rlt_obs(self, env_obs: dict[str, Any]) -> dict[str, torch.Tensor]:
+        """``{"z_rl": [B, z_dim], "proprio": [B, S], "ref_chunk": [B, C, A]}``."""
+        batch = build_lerobot_batch_from_env_obs(env_obs, image_size=self.image_size)
+        if self.prompt_suffix:
+            batch["task"] = [task + self.prompt_suffix for task in batch["task"]]
+        batch = self._prepare_lerobot_batch(batch)
+
+        hidden = self._prefix_hidden(batch) / self.rlt_scale
+        rlt_param = next(self.rlt_module.parameters())
+        z_rl = self.rlt_module.encode_flat(
+            hidden.to(device=rlt_param.device, dtype=rlt_param.dtype)
+        ).float()
+
+        actions = self.policy.predict_action_chunk(batch, noise=self._sample_noise(batch))
+        actions = actions[:, : self.ref_num_action_chunks, : self.action_dim].float()
+        actions = actions.cpu()
+        if self.postprocessor is not None:
+            actions = self.postprocessor(actions)
+        ref_chunk = actions.to(device=z_rl.device, dtype=torch.float32)
+
+        proprio = env_obs["states"].to(device=z_rl.device, dtype=torch.float32)
+        return {"z_rl": z_rl, "proprio": proprio, "ref_chunk": ref_chunk}
