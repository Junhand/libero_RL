+"""Temporal-offset score on RL tokens (STEAM-style progress signal without a VLM critic).
+
+A small MLP maps two RL tokens ``(z_a, z_b)`` of the same episode to the signed temporal offset between
+them, normalised by the episode length (``frames * L_max / T``). It replaces the hand-made grasp reward
+(or the vision-language critic of STEAM) as the quality signal of a transition.
+"""
+
+import torch
+import torch.nn as nn
+
+
+class OffsetMLP(nn.Module):
+    def __init__(self, dim: int = 960, hidden: int = 512):
+        super().__init__()
+        self.f = nn.Sequential(
+            nn.Linear(dim * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+
+    def forward(self, a: torch.Tensor, b: torch.Tensor) -> torch.Tensor:
+        return self.f(torch.cat([a, b, b - a], dim=-1)).squeeze(-1)
+
+
+class OffsetScorer:
+    """Loads ``{"net", "mu", "sd", "Lmax"}`` and scores RL-token pairs."""
+
+    def __init__(self, ckpt_path: str, device: torch.device):
+        ckpt = torch.load(ckpt_path, map_location="cpu", weights_only=False)
+        self.net = OffsetMLP()
+        self.net.load_state_dict(ckpt["net"])
+        self.net.eval().to(device).requires_grad_(False)
+        self.mu = torch.as_tensor(ckpt["mu"], dtype=torch.float32, device=device)
+        self.sd = torch.as_tensor(ckpt["sd"], dtype=torch.float32, device=device)
+        self.lmax = float(ckpt["Lmax"])
+        self.device = device
+
+    @torch.no_grad()
+    def __call__(self, z_a: torch.Tensor, z_b: torch.Tensor) -> torch.Tensor:
+        a = (z_a.to(self.device).float() - self.mu) / self.sd
+        b = (z_b.to(self.device).float() - self.mu) / self.sd
+        return self.net(a, b).cpu()
