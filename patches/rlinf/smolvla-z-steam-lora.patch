+    def _inject_lora(self, cfg: "SteamConfig") -> None:
+        """Inject LoRA adapters in place (module structure and parameter names are kept, plus
+        ``base_layer`` / ``lora_A`` / ``lora_B``) and freeze everything except the adapters.
+        Use ``merge_lora_state_dict`` to turn a trained state dict back into a plain one."""
+        from peft import LoraConfig, inject_adapter_in_model
+
+        import re as _re
+
+        apply_to = {x.strip() for x in _re.split(r"[,+|]", str(cfg.lora_apply_to)) if x.strip()}
+        # SigLIP: only the vision tower (the text tower of the SigLIP checkpoint is unused).
+        targets = {
+            "vision": r".*vision_model.*\.(q_proj|k_proj|v_proj|out_proj|fc1|fc2)",
+            "language": r".*\.(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)",
+        }
+        for key, attr in (("vision", "vision_encoder"), ("language", "language_model")):
+            if key not in apply_to:
+                continue
+            lora_cfg = LoraConfig(
+                r=cfg.lora_r,
+                lora_alpha=cfg.lora_alpha,
+                lora_dropout=cfg.lora_dropout,
+                target_modules=targets[key],
+                bias="none",
+            )
+            module = inject_adapter_in_model(lora_cfg, getattr(self, attr))
+            setattr(self, attr, module)
+            n_train = 0
+            for name, parameter in module.named_parameters():
+                parameter.requires_grad = "lora_" in name
+                n_train += parameter.numel() if parameter.requires_grad else 0
+            logger.info("LoRA injected into %s: %d trainable adapter parameters", attr, n_train)
 
