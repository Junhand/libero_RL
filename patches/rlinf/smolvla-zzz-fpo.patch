+"""Flow-SDE (piRL, arXiv:2510.25889) denoising step for SmolVLA.
+
+The Euler denoising loop (t = 1 noise -> t = 0 action, ``dt = -1 / num_steps``) is the same as OpenPI's, so
+these functions mirror ``rlinf.models.embodiment.openpi.sampling.rl_sampler`` (re-implemented here because
+importing that package requires OpenPI). In the hybrid scheme one randomly chosen denoising step is stochastic
+(an SDE step that preserves the marginals of the ODE) and the others are deterministic Euler steps; the Gaussian
+log-probability of the stochastic step is the exact likelihood of the resulting action.
+"""
+
+import contextlib
+import math
+
+import torch
+
+
+def get_timesteps(num_steps: int, device: torch.device | str) -> torch.Tensor:
+    """``[1, (N-1)/N, ..., 1/N, 0]`` of length ``num_steps + 1``."""
+    timesteps = torch.linspace(1.0, 1.0 / num_steps, num_steps, device=device)
+    return torch.cat([timesteps, torch.zeros(1, device=device)])
+
+
+def sample_mean_std(
+    x_t: torch.Tensor,
+    v_t: torch.Tensor,
+    idx: torch.Tensor,
+    *,
+    sde: bool,
+    noise_level: float,
+    num_steps: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Mean and std of the next sample for the denoising step ``idx`` (``[B]`` long), ``x_t`` and ``v_t``: ``[B, H, D]``."""
+    timesteps = get_timesteps(num_steps, x_t.device).to(x_t.dtype)
+    t_input = timesteps[idx][:, None, None].expand_as(x_t)
+    delta = (timesteps[idx] - timesteps[idx + 1])[:, None, None].expand_as(x_t)
+    x0_pred = x_t - v_t * t_input
+    x1_pred = x_t + v_t * (1 - t_input)
+    x0_weight = 1 - (t_input - delta)
+    if not sde:
+        x1_weight = t_input - delta
+        std = torch.zeros_like(t_input)
+    else:
+        denom_timesteps = torch.where(timesteps == 1, timesteps[1], timesteps)
+        sigma_ratio = timesteps / (1 - denom_timesteps)
+        sigmas = noise_level * torch.sqrt(sigma_ratio)[:-1]
+        sigma_i = sigmas[idx][:, None, None].expand_as(x_t)
+        x1_weight = (t_input - delta) - sigma_i * sigma_i * delta / (2 * t_input)
+        std = torch.sqrt(delta) * sigma_i
+    return x0_pred * x0_weight + x1_pred * x1_weight, std
+
+
+def gaussian_logprob(sample: torch.Tensor, mu: torch.Tensor, sigma: torch.Tensor) -> torch.Tensor:
+    """Per-element Gaussian log-probability; zero wherever ``sigma == 0``."""
+    mask = sigma == 0
+    sigma_safe = torch.where(mask, torch.ones_like(sigma), sigma)
+    log_prob = -torch.log(sigma_safe) - 0.5 * math.log(2 * math.pi) - 0.5 * ((sample - mu) / sigma_safe) ** 2
+    return torch.where(mask, torch.zeros_like(log_prob), log_prob)
+
+
+def prefix_cache(model, images, img_masks, lang_tokens, lang_masks, state, bf16: bool = False):
+    """Image/language/state prefix of ``VLAFlowMatching`` -> ``(pooled features [B, hidden], pad masks, KV cache)``.
+
+    Runs without gradients: the VLM is frozen. The pooled features (mean over valid prefix tokens of the last
+    layer) are the input of the value head. With ``bf16`` the frozen prefix runs under bf16 autocast and its KV
+    cache and features are cast back to fp32 for the (fp32, trainable) action expert: the prefix does not depend
+    on the trained weights, so rollout and training see identical values and the PPO ratio is unaffected.
+    """
+    from lerobot.policies.smolvla.modeling_smolvla import make_att_2d_masks
+
+    autocast = torch.autocast("cuda", dtype=torch.bfloat16) if bf16 else contextlib.nullcontext()
+    with torch.no_grad(), autocast:
+        prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+            images, img_masks, lang_tokens, lang_masks, state=state
+        )
+        prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+        prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+        prefix_outs, past_key_values = model.vlm_with_expert.forward(
+            attention_mask=prefix_att_2d_masks,
+            position_ids=prefix_position_ids,
+            past_key_values=None,
+            inputs_embeds=[prefix_embs, None],
+            use_cache=True,
+        )
+        mask = prefix_pad_masks.to(prefix_outs[0].dtype).unsqueeze(-1)
+        features = ((prefix_outs[0] * mask).sum(dim=1) / mask.sum(dim=1).clamp_min(1.0)).float()
+    if bf16:
+        from transformers import DynamicCache
+
+        cache = DynamicCache()
+        for layer_idx, layer in enumerate(past_key_values.layers):
+            cache.update(layer.keys.float(), layer.values.float(), layer_idx)
+        past_key_values = cache
+    return features, prefix_pad_masks, past_key_values
