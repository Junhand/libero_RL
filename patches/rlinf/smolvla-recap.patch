@@ -0,0 +1,93 @@
+# RECAP Step 4 for LeRobot SmolVLA: advantage-conditioned SFT.
+#
+# Positive-advantage frames are trained with "{task}\nAdvantage: positive"
+# (dropped to "{task}" with probability unconditional_prob), negative frames with
+# "{task}". Evaluate the result with model.smolvla.advantage_prompt=true
+# (equivalent to RLinf's CFG model with cfgrl_guidance_scale=1.0).
+#
+# Launch: bash examples/sft/run_vla_sft.sh libero10_task0_recap_smolvla
+# Prereq: LeRobot v3.0 copies of the RECAP datasets and the
+#         meta/advantages_{tag}.parquet files from RECAP Step 3.
+
+defaults:
+  - model/smolvla@actor.model
+  - hybrid_engines/fsdp@actor.fsdp_config
+  - override hydra/job_logging: stdout
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+  searchpath:
+    - file://${oc.env:EMBODIED_PATH}/config/
+    - file://${oc.env:REPO_PATH}/examples/embodiment/config/
+
+cluster:
+  num_nodes: 1
+  component_placement:
+    actor,env,rollout: all
+
+runner:
+  task_type: sft
+  logger:
+    log_path: "../results"
+    project_name: rlinf
+    experiment_name: "smolvla_recap_sft"
+    logger_backends: ["tensorboard"]
+
+  max_epochs: -1
+  max_steps: 30000
+  val_check_interval: -1
+  save_interval: 3000
+
+data:
+  train_data_paths:
+    - dataset_path: "/path/to/v30/libero10_task0_sft"
+      advantages_path: "/path/to/libero10_task0_sft/meta/advantages_fail300_N10_q30.parquet"
+      weight: 1.0
+    - dataset_path: "/path/to/v30/libero10_task0_train"
+      advantages_path: "/path/to/libero10_task0_train/meta/advantages_fail300_N10_q30.parquet"
+      weight: 1.0
+  balance_dataset_weights: true
+  unconditional_prob: 0.1
+  num_workers: 8
+  seed: 42
+
+actor:
+  group_name: "ActorGroup"
+  training_backend: "fsdp"
+  micro_batch_size: 32
+  global_batch_size: 256
+  seed: 0
+
+  model:
+    model_path: "/path/to/smolvla_libero_plus"
+    smolvla:
+      advantage_prompt: true
+
+  optim:
+    lr: 1.0e-5
+    adam_beta1: 0.9
+    adam_beta2: 0.95
+    adam_eps: 1.0e-8
+    weight_decay: 1.0e-10
+    clip_grad: 10.0
+    warmup_style: "cosine"
+    lr_warmup_steps: 1000
+    total_training_steps: 30000
+
+  fsdp_config:
+    strategy: "fsdp"
+    sharding_strategy: "no_shard"
+    use_orig_params: False
+    gradient_checkpointing: False
+    mixed_precision:
+      param_dtype: ${actor.model.precision}
+      reduce_dtype: ${actor.model.precision}
+      buffer_dtype: ${actor.model.precision}
+
+reward:
+  use_reward_model: False
+
+critic:
+  use_critic_model: False
