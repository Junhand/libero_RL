+# limitations under the License.
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Any, Literal
+
+import torch
+import torch.nn as nn
+
+from rlinf.models.embodiment.base_policy import BasePolicy, ForwardType
+from rlinf.models.embodiment.pi0_fast.lerobot_io import (
+    build_lerobot_batch_from_env_obs,
+)
+
+
+# Same conditional prompt as RLinf's CFG model (rlinf/data/datasets/recap/cfg_model.py).
+ADVANTAGE_PROMPT_SUFFIX = "\nAdvantage: positive"
+
+
+class SmolVLAForRLActionPrediction(nn.Module, BasePolicy):
+    """Adapt LeRobot SmolVLA inference and flow-matching SFT to RLinf's policy API.
+
+    ``prompt_suffix`` is appended to every task description at inference. For
+    RECAP (advantage-conditioned training, see
+    ``rlinf/data/datasets/recap/smolvla_cfg.py``) it is
+    ``ADVANTAGE_PROMPT_SUFFIX``, which matches RLinf's CFG model with
+    ``cfgrl_guidance_scale=1.0`` (conditional prediction only).
+    """
+
+    def __init__(
+        self,
+        policy: nn.Module,
+        *,
+        action_dim: int,
+        num_action_chunks: int,
+        prompt_suffix: str = "",
+        image_size: int | None = None,
+        preprocessor: Callable[[dict[str, Any]], dict[str, Any]] | None = None,
+        postprocessor: Callable[[torch.Tensor], torch.Tensor] | None = None,
+    ) -> None:
+        super().__init__()
+        self.policy = policy
+        self.action_dim = int(action_dim)
+        self.num_action_chunks = int(num_action_chunks)
+        self.prompt_suffix = prompt_suffix
+        self.image_size = image_size
+        self.preprocessor = preprocessor
+        self.postprocessor = postprocessor
+
+    def _prepare_lerobot_batch(self, batch: dict[str, Any]) -> dict[str, Any]:
+        """Rename, tokenize and normalize, then move tensors to the policy device."""
+        if self.preprocessor is not None:
+            batch = self.preprocessor(batch)
+        first_param = next(self.parameters())
+        prepared = {}
+        for key, value in batch.items():
+            if torch.is_tensor(value):
+                if value.is_floating_point():
+                    value = value.to(device=first_param.device, dtype=first_param.dtype)
+                else:
+                    value = value.to(device=first_param.device)
+            prepared[key] = value
+        return prepared
+
+    def predict_action_batch(
+        self,
+        env_obs: dict[str, Any],
+        mode: Literal["train", "eval"] = "train",
+        **kwargs: Any,
+    ) -> tuple[torch.Tensor, dict[str, Any]]:
+        """Predict one action chunk for each environment.
+
+        Args:
+            env_obs: Batched RLinf environment observations.
+            mode: Rollout mode. SmolVLA inference is the same in both modes.
+            **kwargs: Unused RLinf sampling parameters.
+
+        Returns:
+            Unnormalized actions ``[B, num_action_chunks, action_dim]`` on CPU and
+            an empty rollout result (no logprobs or values).
+        """
+        del mode, kwargs
+        batch = build_lerobot_batch_from_env_obs(env_obs, image_size=self.image_size)
+        if self.prompt_suffix:
+            batch["task"] = [task + self.prompt_suffix for task in batch["task"]]
+        batch = self._prepare_lerobot_batch(batch)
+
+        actions = self.policy.predict_action_chunk(batch)
+        actions = actions[:, : self.num_action_chunks, : self.action_dim]
+        actions = actions.float().cpu()
+        if self.postprocessor is not None:
+            actions = self.postprocessor(actions)
+        return actions, {
+            "prev_logprobs": None,
+            "prev_values": None,
+            "forward_inputs": {},
+        }
+
+    def forward(self, forward_type=ForwardType.DEFAULT, **kwargs):
+        if forward_type == ForwardType.SFT:
+            return self.sft_forward(**kwargs)
+        raise NotImplementedError(
+            f"smolvla does not implement forward_type={forward_type!r}."
+        )
+
+    def default_forward(self, **kwargs):
+        raise NotImplementedError(
+            "smolvla supports evaluation rollouts and SFT only (no RL actor update)."
+        )
+
+    def sft_forward(self, data: dict[str, Any], **kwargs: Any) -> dict[str, torch.Tensor]:
+        """Flow-matching loss on a batch from ``build_smolvla_recap_sft_dataloader``."""
+        del kwargs
+        batch = self._prepare_lerobot_batch(dict(data))
+        loss, _ = self.policy.forward(batch)
+        return {"loss": loss}
