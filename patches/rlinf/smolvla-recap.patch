+"""SmolVLA embodied policy wrapper for RLinf.
+
+Exposes ``get_model``, which loads LeRobot's ``SmolVLAPolicy`` (e.g.
+``lerobot/smolvla_libero_plus``) from a checkpoint directory and wraps it in
+``SmolVLAForRLActionPrediction`` for evaluation rollouts and SFT.
+"""
+
+from __future__ import annotations
+
+import torch
+from omegaconf import DictConfig, OmegaConf
+
+from rlinf.models.embodiment.smolvla.smolvla_action_model import (
+    ADVANTAGE_PROMPT_SUFFIX,
+    SmolVLAForRLActionPrediction,
+)
+
+# RLinf env observations are converted to lerobot/libero keys; SmolVLA LIBERO
+# checkpoints expect camera1 (agent view) / camera2 (wrist).
+DEFAULT_RENAME_MAP = {
+    "observation.images.image": "observation.images.camera1",
+    "observation.images.image2": "observation.images.camera2",
+}
+
+
+def _load_processor(model_path: str, processor_type: str, overrides: dict):
+    from lerobot.processor import PolicyProcessorPipeline
+
+    loader_kwargs = {}
+    if processor_type == "pre":
+        # Registers smolvla_new_line_processor.
+        import lerobot.policies.smolvla.processor_smolvla  # noqa: F401
+
+        config_filename = "policy_preprocessor.json"
+    else:
+        from lerobot.processor.converters import (
+            policy_action_to_transition,
+            transition_to_policy_action,
+        )
+
+        config_filename = "policy_postprocessor.json"
+        loader_kwargs = {
+            "to_transition": policy_action_to_transition,
+            "to_output": transition_to_policy_action,
+        }
+
+    # The device step is dropped below; build it on CPU so loading never needs CUDA.
+    overrides = {"device_processor": {"device": "cpu"}, **overrides}
+    processor = PolicyProcessorPipeline.from_pretrained(
+        model_path, config_filename=config_filename, overrides=overrides, **loader_kwargs
+    )
+    # Inputs are already batched, and the wrapper moves tensors to the policy
+    # device itself (works for rollout workers, FSDP ranks and CPU alike).
+    processor.steps = [
+        step
+        for step in processor.steps
+        if step.__class__.__name__
+        not in ("AddBatchDimensionProcessorStep", "DeviceProcessorStep")
+    ]
+    return processor
+
+
+def get_model(
+    cfg: DictConfig,
+    torch_dtype: torch.dtype | None = None,
+) -> SmolVLAForRLActionPrediction:
+    """Build an RLinf policy wrapper around LeRobot's SmolVLAPolicy.
+
+    Args:
+        cfg: SmolVLA model configuration (``model/smolvla.yaml``).
+        torch_dtype: Requested model dtype; ``None`` keeps float32 weights.
+
+    Returns:
+        The SmolVLA policy adapted to RLinf's embodied policy interface.
+    """
+    try:
+        from lerobot.configs.policies import PreTrainedConfig
+        from lerobot.policies.smolvla import SmolVLAConfig, SmolVLAPolicy
+    except ImportError as exc:
+        raise ImportError(
+            "smolvla requires LeRobot with SmolVLA support. Install with: "
+            "bash requirements/install.sh embodied --model pi0_fast --env libero "
+            "&& uv pip install 'num2words>=0.5.14,<0.6.0'"
+        ) from exc
+
+    model_cfg = cfg.get("smolvla", {}) or {}
+    model_path = str(cfg.model_path)
+
+    policy_config = PreTrainedConfig.from_pretrained(model_path)
+    if not isinstance(policy_config, SmolVLAConfig):
+        raise TypeError(
+            "Expected a LeRobot SmolVLAConfig for smolvla model_path, got "
+            f"{type(policy_config).__name__}."
+        )
+    num_action_chunks = int(cfg.num_action_chunks)
+    if not 0 < num_action_chunks <= policy_config.chunk_size:
+        raise ValueError(
+            f"smolvla num_action_chunks must be in [1, {policy_config.chunk_size}], "
+            f"got {num_action_chunks}."
+        )
+    checkpoint_action_dim = policy_config.output_features["action"].shape[0]
+    if int(cfg.action_dim) != checkpoint_action_dim:
+        raise ValueError(
+            "smolvla model.action_dim must match the checkpoint action feature "
+            f"({checkpoint_action_dim}), got {cfg.action_dim}."
+        )
+
+    # The full policy weights come from the checkpoint; do not download the
+    # SmolVLM2 backbone weights again.
+    policy_config.load_vlm_weights = False
+    if model_cfg.get("vlm_model_name"):
+        policy_config.vlm_model_name = str(model_cfg.vlm_model_name)
+    policy_config.device = "cpu"
+
+    policy = SmolVLAPolicy.from_pretrained(model_path, config=policy_config)
+    if torch_dtype is not None:
+        policy = policy.to(dtype=torch_dtype)
+
+    rename_map = model_cfg.get("rename_map")
+    rename_map = (
+        OmegaConf.to_container(rename_map, resolve=True)
+        if rename_map is not None
+        else DEFAULT_RENAME_MAP
+    )
+    pre_overrides = {"rename_observations_processor": {"rename_map": rename_map}}
+    if model_cfg.get("vlm_model_name"):
+        pre_overrides["tokenizer_processor"] = {
+            "tokenizer_name": str(model_cfg.vlm_model_name)
+        }
+
+    return SmolVLAForRLActionPrediction(
+        policy,
+        action_dim=int(cfg.action_dim),
+        num_action_chunks=num_action_chunks,
+        prompt_suffix=(
+            ADVANTAGE_PROMPT_SUFFIX if model_cfg.get("advantage_prompt", False) else ""
+        ),
+        image_size=model_cfg.get("image_size", None),
+        preprocessor=_load_processor(model_path, "pre", pre_overrides),
+        postprocessor=_load_processor(model_path, "post", {}),
+    )
+
+
+__all__ = ["SmolVLAForRLActionPrediction", "get_model"]
