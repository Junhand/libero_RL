+model_type: "smolvla"
+
+# LeRobot SmolVLA checkpoint, e.g. https://huggingface.co/lerobot/smolvla_libero_plus
+model_path: "/path/to/smolvla_libero_plus"
+
+# null keeps float32 weights (LeRobot trains SmolVLA in float32).
+precision: null
+load_to_device: True
+
+# Actions executed per env step out of the 50-step SmolVLA chunk.
+# max_steps_per_rollout_epoch must be divisible by this.
+num_action_chunks: 10
+action_dim: 7
+
+is_lora: False
+add_value_head: False
+
+smolvla:
+  # Append "\nAdvantage: positive" to every task prompt at inference.
+  # true for RECAP-trained policies, false for the base checkpoint.
+  advantage_prompt: false
+  # Local path to HuggingFaceTB/SmolVLM2-500M-Video-Instruct (config, processor,
+  # tokenizer) for offline use; null downloads it from the Hub.
+  vlm_model_name: null
+  # Action horizon used to build SFT targets (checkpoint chunk_size).
+  chunk_size: 50
+  # RLinf env / dataset image keys -> checkpoint camera keys.
+  rename_map:
+    observation.images.image: observation.images.camera1
+    observation.images.image2: observation.images.camera2
