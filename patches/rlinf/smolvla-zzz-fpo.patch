+"""Plain LeRobot demonstrations for SmolVLA flow-matching SFT (RL co-training).
+
+Unlike ``rlinf.data.datasets.recap.smolvla_cfg`` there is no advantage labelling or prompt suffix: every frame
+is a supervised sample (50-step action chunk, language task, images, state) for ``SmolVLAForRLActionPrediction.sft_forward``.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import torch
+from omegaconf import DictConfig, OmegaConf
+from torch.utils.data import DataLoader, Dataset
+
+# RLinf collected datasets (libero10_task0_*) -> lerobot/libero keys.
+DEFAULT_KEY_MAP = {
+    "image": "observation.images.image",
+    "wrist_image": "observation.images.image2",
+    "state": "observation.state",
+    "actions": "action",
+}
+
+
+class SmolVLADemoDataset(Dataset):
+    def __init__(
+        self,
+        dataset_path: str,
+        chunk_size: int = 50,
+        key_map: dict[str, str] | None = None,
+        video_backend: str | None = None,
+    ) -> None:
+        from lerobot.datasets.lerobot_dataset import LeRobotDataset
+
+        root = Path(dataset_path)
+        key_map = dict(key_map or DEFAULT_KEY_MAP)
+        action_key = next(src for src, dst in key_map.items() if dst == "action")
+        probe = LeRobotDataset(f"local/{root.name}", root=root, video_backend=video_backend)
+        fps = probe.meta.fps
+        self.dataset = LeRobotDataset(
+            f"local/{root.name}",
+            root=root,
+            delta_timestamps={action_key: [i / fps for i in range(chunk_size)]},
+            video_backend=video_backend,
+        )
+        self.key_map = key_map
+        self.key_map[f"{action_key}_is_pad"] = "action_is_pad"
+
+    def __len__(self) -> int:
+        return len(self.dataset)
+
+    def __getitem__(self, idx: int) -> dict[str, Any]:
+        item = self.dataset[idx]
+        sample = {dst: item[src] for src, dst in self.key_map.items()}
+        sample["task"] = item["task"]
+        return sample
+
+
+def build_smolvla_demo_dataloader(cfg: DictConfig, data_path: str, seed: int = 0) -> DataLoader:
+    """Shuffled, endlessly re-iterable loader over the demonstrations in ``data_path``."""
+    model_cfg = cfg.actor.model
+    smolvla_cfg = model_cfg.get("smolvla", {}) or {}
+    key_map = cfg.actor.get("sft_key_map", None)
+    key_map = OmegaConf.to_container(key_map, resolve=True) if key_map else None
+    dataset = SmolVLADemoDataset(
+        dataset_path=data_path,
+        chunk_size=int(smolvla_cfg.get("chunk_size", 50)),
+        key_map=key_map,
+        video_backend=cfg.actor.get("sft_video_backend", None),
+    )
+    generator = torch.Generator().manual_seed(int(seed))
+    num_workers = int(cfg.actor.get("sft_num_workers", 0))
+    return DataLoader(
+        dataset,
+        batch_size=int(cfg.actor.get("sft_batch_size", cfg.actor.micro_batch_size)),
+        shuffle=True,
+        generator=generator,
+        num_workers=num_workers,
+        drop_last=True,
+        persistent_workers=num_workers > 0,
+    )
