+"""Videos of training episodes built from the rollout data the actor already holds (no extra inference).
+
+The actor stores the observation of every action chunk (agent-view and wrist images) for the PPO update, so one
+frame per chunk (every ``num_action_chunks`` environment steps) is available. One successful and one failed
+episode are written per update as ``<out_dir>/{success,fail}_env<k>.mp4`` (agent view | wrist view, with the chunk
+index, the cumulative reward and the value estimate).
+"""
+
+from __future__ import annotations
+
+import os
+from typing import Any
+
+import numpy as np
+import torch
+
+
+def _first_index(mask: np.ndarray) -> int | None:
+    idx = np.flatnonzero(mask)
+    return int(idx[0]) if idx.size else None
+
+
+def select_episodes(success: np.ndarray) -> list[tuple[str, int]]:
+    """``[("success", env), ("fail", env)]`` for the first successful and the first failed episode.
+
+    If one kind is missing, the first two episodes are used instead and labelled by their own outcome.
+    """
+    ok, bad = _first_index(success), _first_index(~success)
+    chosen = [(label, e) for label, e in (("success", ok), ("fail", bad)) if e is not None]
+    if len(chosen) < 2:
+        chosen = [("success" if success[e] else "fail", e) for e in range(min(2, len(success)))]
+    return chosen
+
+
+def _annotate(frame: np.ndarray, lines: list[str]) -> np.ndarray:
+    from PIL import Image, ImageDraw
+
+    image = Image.fromarray(frame)
+    draw = ImageDraw.Draw(image)
+    y = 3
+    for line in lines:
+        draw.rectangle([0, y - 1, 8 + 6 * len(line), y + 10], fill=(0, 0, 0))
+        draw.text((4, y), line, fill=(255, 255, 255))
+        y += 12
+    return np.asarray(image)
+
+
+def save_rollout_videos(
+    rollout_batch: dict[str, Any],
+    out_dir: str,
+    *,
+    fps: int = 4,
+    max_success_reward: float = 0.99,
+) -> list[str]:
+    """Write the videos and return their paths (empty list if the batch has no images)."""
+    import imageio.v2 as imageio
+
+    inputs = rollout_batch.get("forward_inputs") or {}
+    main, wrist = inputs.get("main_images"), inputs.get("wrist_images")
+    if main is None or wrist is None:
+        return []
+    main, wrist = main.cpu().numpy(), wrist.cpu().numpy()  # [T, E, H, W, 3] uint8
+    n_chunks, n_envs = main.shape[:2]
+    rewards = rollout_batch["rewards"].float().cpu().numpy().sum(-1)  # [T, E] chunk reward
+    values = rollout_batch["prev_values"].float().cpu().numpy()[:n_chunks, :, 0]  # [T, E] value before the chunk
+    loss_mask = rollout_batch.get("loss_mask")
+    if loss_mask is not None:
+        valid = loss_mask.cpu().numpy().reshape(n_chunks, n_envs, -1).max(-1) > 0
+    else:
+        valid = np.ones((n_chunks, n_envs), dtype=bool)
+    length = valid.sum(0)  # valid chunks per episode (the chunk in which the episode ends is included)
+    success = ((rewards >= max_success_reward) & valid).any(0)
+
+    os.makedirs(out_dir, exist_ok=True)
+    paths = []
+    for label, env in select_episodes(success):
+        n = int(max(length[env], 1))
+        total = 0.0
+        frames = []
+        for t in range(min(n + 1, n_chunks)):  # one frame after the last action when available
+            total += float(rewards[t - 1, env]) if t > 0 else 0.0
+            frame = np.concatenate([main[t, env], wrist[t, env]], axis=1)
+            lines = [f"{label.upper()}  chunk {t}/{n}  step {t * 10}", f"return so far {total:.2f}   V {values[t, env]:.2f}"]
+            frames.append(_annotate(frame, lines))
+        path = os.path.join(out_dir, f"{label}_env{env}.mp4")
+        imageio.mimwrite(path, frames, fps=fps, codec="libx264", quality=7, macro_block_size=None)
+        paths.append(path)
+    return paths
