+# Evaluation of an RLT actor on top of a frozen SmolVLA (see examples/embodiment/config/libero_10_smolvla_rlt_stage2.yaml).
+# The protocol is the one of libero_10_smolvla_eval.yaml: the 50 fixed initial states of Task 0, each run once
+# (max 520 steps, the first 10 actions of the 50-step chunk are executed), metric eval/success_once.
+# The actor acts until the first object is held (env.eval.rlt_policy_switch), SmolVLA finishes the task.
+#
+#   bash evaluations/run_eval.sh libero libero_10_smolvla_rlt_eval \
+#     rollout.rlt_feature_model.model_path=/path/to/smolvla_libero \
+#     rollout.rlt_feature_model.smolvla.vlm_model_name=/path/to/SmolVLM2-500M-Video-Instruct \
+#     rollout.rlt_feature_model.smolvla.rlt_token_ckpt=/path/to/rlt_stage1_ckpt.pt \
+#     runner.ckpt_path=/path/to/checkpoints/global_step_<N>/actor/model_state_dict/full_weights.pt \
+#     +env.eval.task_id_filter=[0] env.eval.total_num_envs=2 env.eval.max_steps_per_rollout_epoch=13000
+#
+# Without runner.ckpt_path and with env.eval.rlt_policy_switch.enable=False the same command evaluates SmolVLA alone
+# through this code path. With few envs, raise max_steps_per_rollout_epoch to 520 * (50 / total_num_envs).
+
+defaults:
+  - env/libero_10@env.eval
+  - override hydra/job_logging: stdout
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+  searchpath:
+    - file://${oc.env:EMBODIED_PATH}/config/
+
+cluster:
+  num_nodes: 1
+  component_placement:
+    env,rollout: all
+
+runner:
+  task_type: embodied_eval
+  logger:
+    log_path: "../results"
+    project_name: rlinf
+    experiment_name: "libero_10_smolvla_rlt_eval"
+    logger_backends: ["tensorboard"]
+
+  max_epochs: 1
+  max_steps: -1
+  only_eval: True
+  val_check_interval: -1
+  save_interval: -1
+  resume_dir: null
+  ckpt_path: null # RLT actor weights (full_weights.pt); null = untrained actor (use with the switch disabled)
+
+algorithm:
+  loss_type: rlt_ac
+
+env:
+  group_name: "EnvGroup"
+  eval:
+    task_id_filter: [0]
+    rollout_epoch: 1
+    total_num_envs: 2
+    auto_reset: True
+    ignore_terminations: True
+    use_rel_reward: False
+    reward_coef: 1.0
+    max_episode_steps: 520
+    max_steps_per_rollout_epoch: 13000
+    group_size: 1
+    is_eval: True
+    rlt_policy_switch:
+      enable: True
+      mode: full_task
+      hold_gap_min: 0.04
+      hold_gap_max: 0.071
+      hold_min_steps: 8
+      num_phases: 1 # 2: the actor also acts from the release of the first object until the second grasp
+      release_min_steps: 3
+      actor_phase: 0 # learned actor acts from this phase on (1 = second grasp only)
+      pre_actor: False # True: the frozen rollout.rlt_pre_actor acts in the earlier phases (flags get 2 columns)
+    video_cfg:
+      save_video: True
+      video_base_dir: ${runner.logger.log_path}/video/eval
+
+rollout:
+  group_name: "RolloutGroup"
+  generation_backend: "huggingface"
+  recompute_logprobs: False
+  enable_offload: False
+  pipeline_stage_num: 1
+
+  model:
+    model_type: "rlt_mlp_policy"
+    model_path: ""
+    precision: fp32
+    policy_setup: "panda-qpos"
+    action_dim: 7
+    num_action_chunks: 10
+    ref_num_action_chunks: 10
+    z_dim: 960
+    proprio_dim: 8
+    add_value_head: False
+    add_q_head: True
+    q_head_type: "default"
