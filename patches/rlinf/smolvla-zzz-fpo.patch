+# PPO with a Flow-SDE policy (piRL, arXiv:2510.25889) for SmolVLA on LIBERO-10 Task 0. Hyper-parameters follow RLinf's
+# PPO recipe (examples/embodiment/config/libero_10_ppo_openpi_pi05.yaml) except for the sample budget: 3 environments (host memory)
+# give 15 episodes per update instead of 512. Model: rlinf/models/embodiment/smolvla/smolvla_sde_model.py (design: docs/flow_sde_ppo_smolvla_design.md).
+#   bash: cd tmp/hybrid_fpo; CONFIG=libero_10_smolvla_ppo_sde EPOCHS=30 ./run_cfg.sh   (see scripts/fpo/)
+#   or:   python examples/embodiment/train_embodied_agent.py --config-name libero_10_smolvla_ppo_sde \
+#     actor.model.model_path=/path/to/smolvla_libero actor.model.smolvla.vlm_model_name=/path/to/SmolVLM2-500M-Video-Instruct
+defaults:
+  - env/libero_10@env.train
+  - env/libero_10@env.eval
+  - hybrid_engines/fsdp@actor.fsdp_config
+  - weight_syncer/patch_syncer@weight_syncer
+  - override hydra/job_logging: stdout
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+  searchpath:
+    - file://${oc.env:EMBODIED_PATH}/config/
+
+cluster:
+  num_nodes: 1
+  component_placement:
+    actor,env,rollout: all
+
+runner:
+  task_type: embodied
+  logger:
+    log_path: "../results"
+    project_name: rlinf
+    experiment_name: "libero_10_smolvla_ppo_sde"
+    logger_backends: ["tensorboard"]
+
+  max_epochs: 40 # number of PPO updates
+  rollout_video:                # videos made from the stored training rollouts (no extra inference): one success, one failure
+    enabled: False
+    every_n_updates: 1
+    fps: 4
+  max_steps: -1
+  only_eval: False
+  val_check_interval: -1
+  save_interval: 5
+  resume_dir: null
+  ckpt_path: null
+
+algorithm:
+  normalize_advantages: True
+  group_size: 1
+  reward_coef: 1.0
+
+  reward_type: chunk_level
+  logprob_type: chunk_level   # one ratio per action chunk (sum of the log-probs of the stochastic denoising step)
+  logprob_last_dim: 7         # = action_dim
+  entropy_type: token_level
+  update_epoch: 4
+  recompute_logprobs: True      # old log-probs recomputed by the actor before each update: removes the bf16 batch-shape noise from the ratio
+  target_kl: 0.1              # not in the RLinf recipe; stops the remaining epochs of an update when the mean epoch KL (k3) exceeds it
+  adv_type: gae
+  loss_type: actor_critic
+  loss_agg_func: "token-mean"
+  kl_beta: 0.0
+  entropy_bonus: 0
+  clip_ratio_high: 0.2
+  clip_ratio_low: 0.2
+  clip_ratio_c: 3.0
+  value_clip: 0.2
+  huber_delta: 10.0
+
+  gamma: 0.99                 # per action chunk, as in libero_10_ppo_openpi_pi05.yaml
+  gae_lambda: 0.95
+
+  filter_rewards: False
+
+env:
+  group_name: "EnvGroup"
+  train:
+    task_id_filter: [0]
+    rollout_epoch: 5          # episodes per environment per update
+    total_num_envs: 3
+    seed: 2026
+    auto_reset: False
+    ignore_terminations: False
+    use_fixed_reset_state_ids: True
+    use_ordered_reset_state_ids: False
+    use_rel_reward: True   # success is rewarded once (reward - previous step reward), as in the RLinf recipe
+    # Shaping (off by default): a one-off bonus when a target object is first grasped and lifted by lift_height [m]; the first
+    # object grasped earns rewards[0], the second rewards[1]; the first object put into the basket and released earns place_rewards[0]
+    # (Task 0: alphabet soup and tomato sauce). Task success keeps its reward 1.
+    grasp_reward:
+      enabled: False
+      objects: [alphabet_soup_1, tomato_sauce_1]
+      rewards: [0.2, 0.2]          # n-th object grasped and lifted
+      place_rewards: [0.3, 0.0]    # n-th object in the basket and released (the second one is the task success: reward 1)
+      lift_height: 0.02
+    reward_coef: ${algorithm.reward_coef}
+    max_episode_steps: 480
+    max_steps_per_rollout_epoch: 480
+    group_size: 1
+    skip_intermediate_renders: True
+    video_cfg:
+      save_video: False
+  eval:
+    task_id_filter: [0]
+    rollout_epoch: 1
+    total_num_envs: 2
+    seed: 2026
+    auto_reset: True
+    ignore_terminations: True
+    use_rel_reward: False
+    reward_coef: 1.0
+    max_episode_steps: 520
+    max_steps_per_rollout_epoch: 13000
+    group_size: 1
+    use_fixed_reset_state_ids: True
+    is_eval: True
+    video_cfg:
+      save_video: False
+
+rollout:
+  group_name: "RolloutGroup"
+  generation_backend: "huggingface"
+  recompute_logprobs: False
+  enable_offload: False
+  pipeline_stage_num: 1
+  collect_prev_infos: True
+
+  model:
+    model_type: ${actor.model.model_type}
+    model_path: ${actor.model.model_path}
+    precision: ${actor.model.precision}
+    add_value_head: ${actor.model.add_value_head}
+    action_dim: ${actor.model.action_dim}
+    num_action_chunks: ${actor.model.num_action_chunks}
+    is_lora: False
+    smolvla: ${actor.model.smolvla}
+
+actor:
+  group_name: "ActorGroup"
+  training_backend: "fsdp"
+  micro_batch_size: 10
+  global_batch_size: 120      # rollout entries per update (48 chunk steps x 3 envs x 5 epochs = 720) must be divisible by this
+  seed: 1234
+  enable_offload: False
+  # SFT co-training (RLinf's PPO + SFT on demonstrations): loss = PPO loss + sft_loss_weight * flow-matching loss of a demo batch,
+  # added to every PPO micro-batch (rlinf/data/datasets/smolvla_sft.py). Enable with actor.enable_sft_co_train=True.
+  enable_sft_co_train: False
+  sft_loss_weight: 5.0          # SFT grad norm is ~1-4 at weight 1; the PPO grad norm is ~30-50 before clipping
+  sft_data_path: "/workspace/libero_RL/data/smolvla_recap/v30/libero10_task0_sft_target3"   # LeRobot v3.0 root, 3 human demos of Task 0
+  sft_batch_size: 8
+  sft_num_workers: 0
+
+  model:
+    model_type: "smolvla"
+    model_path: "/path/to/smolvla_libero"
+    precision: fp32
+    add_value_head: True        # required by loss_type actor_critic; the value head itself lives in SmolVLAForFPO (base of SmolVLAForFlowSDE)
+    action_dim: 7
+    num_action_chunks: 10
+    is_lora: False
+    smolvla:
+      vlm_model_name: "/path/to/SmolVLM2-500M-Video-Instruct"
+      noise_seed: null          # random initial flow noise
+      chunk_size: 50
+      advantage_prompt: False
+      rename_map:
+        observation.images.image: observation.images.camera1
+        observation.images.image2: observation.images.camera2
+      sde:
+        enabled: True
+        noise_level: 0.5        # piRL: 0.2 unstable, 0.5 best, 0.8 degrades
+        num_steps: 10           # Euler steps (smolVLA's default; RLinf's pi0.5 recipe uses 5). Evaluate with the same value (NSTEPS)
+        prefix_bf16: True       # frozen VLM prefix in bf16 (training ~2.7x, rollout policy ~1.5x faster); the expert and the loss stay fp32
+        value_hidden_dims: [512, 256]
+        state_dim: 8
+
+  optim:
+    lr: 5.0e-6
+    value_lr: 1.0e-4
+    adam_beta1: 0.9
+    adam_beta2: 0.95
+    adam_eps: 1.0e-08
+    weight_decay: 0.01
+    clip_grad: 1.0
+    critic_warmup_steps: 24     # optimizer steps of the first update (value only): 6 mini-batches x 4 epochs
+    total_training_steps: 30
+    min_lr_rate: 0.1
+    lr_scheduler: "cosine"
+
+  fsdp_config:
+    strategy: "fsdp"
+    sharding_strategy: "no_shard"
+    save_training_state: False  # keep only the full weights: saving the sharded optimizer state hits the host-memory limit
+    use_orig_params: True       # frozen (VLM) and trainable (expert, value head) parameters share FSDP units
+    gradient_checkpointing: False
+    mixed_precision:
+      param_dtype: ${actor.model.precision}
+      reduce_dtype: ${actor.model.precision}
+      buffer_dtype: ${actor.model.precision}
+
+reward:
+  use_reward_model: False
+
+critic:
+  use_critic_model: False
