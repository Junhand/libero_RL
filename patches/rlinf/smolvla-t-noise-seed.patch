+    def _sample_noise(self, batch: dict[str, Any]) -> torch.Tensor | None:
+        """Standard-normal x_1 noise for the whole batch from the seeded generator."""
+        if self.noise_seed is None:
+            return None
+        device = next(self.parameters()).device
+        if self._noise_generator is None:
+            self._noise_generator = torch.Generator(device=device)
+            self._noise_generator.manual_seed(self.noise_seed)
+        batch_size = next(v.shape[0] for v in batch.values() if torch.is_tensor(v))
+        config = self.policy.config
+        return torch.randn(
+            (batch_size, config.chunk_size, config.max_action_dim),
+            generator=self._noise_generator,
+            device=device,
+            dtype=torch.float32,
+        )
