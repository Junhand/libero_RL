+import torch
+
+from rlinf.models.embodiment.mlp_policy.mlp_policy import MLPPolicy
+from rlinf.models.embodiment.mlp_policy.rlt_mlp_policy import RLTMLPPolicy
+
+
+class DSRLMLPPolicy(RLTMLPPolicy):
+    """DSRL (diffusion steering) head on the RL token: SAC in the initial-noise space of a frozen flow-matching VLA.
+
+    The actor maps (z_rl, proprio) to the initial noise of the first ``num_action_chunks`` action steps
+    (``action_dim`` = the VLA's noise dimension per step, 32 for SmolVLA); the rollout decodes it with the frozen
+    VLA (``feature_model.decode_with_noise``). The noise distribution is N(mu(s), fixed_std^2) with
+    mu = mean_max * tanh(.), so an untrained actor reproduces the VLA's own N(0, I) sampling. The critic scores
+    (z_rl, proprio, noise). The replay stores the noise as the action.
+    """
+
+    is_dsrl = True
+
+    def __init__(
+        self,
+        z_dim: int,
+        proprio_dim: int,
+        action_dim: int,
+        num_action_chunks: int,
+        add_q_head: bool = True,
+        q_head_type: str = "default",
+        fixed_std: float = 1.0,
+        mean_max: float = 1.5,
+        noise_clip: float = 3.0,
+    ):
+        if not add_q_head:
+            raise ValueError("DSRLMLPPolicy requires add_q_head=True.")
+        self.z_dim = int(z_dim)
+        self.proprio_dim = int(proprio_dim)
+        self.step_action_dim = int(action_dim)  # noise dimension per action step
+        self.chunk_len = int(num_action_chunks)
+        self.ref_chunk_len = self.chunk_len
+        self.flat_action_dim = self.chunk_len * self.step_action_dim
+        MLPPolicy.__init__(
+            self,
+            obs_dim=self.z_dim + self.proprio_dim,
+            action_dim=self.flat_action_dim,
+            num_action_chunks=1,
+            add_value_head=False,
+            add_q_head=add_q_head,
+            q_head_type=q_head_type,
+            critic_obs_dim=self.z_dim + self.proprio_dim,
+        )
+        self.fixed_std = float(fixed_std)
+        self.mean_max = float(mean_max)
+        self.noise_clip = float(noise_clip)
+
+    def _actor_state(self, obs: dict, **kwargs) -> torch.Tensor:
+        return torch.cat([self._get_z(obs), self._get_proprio(obs)], dim=-1)
+
+    def noise_mean(self, obs: dict) -> torch.Tensor:
+        return self.mean_max * torch.tanh(self.actor_mean(self.backbone(self._actor_state(obs))))
+
+    def sac_forward(self, obs, deterministic: bool = False, **kwargs):
+        mean = self.noise_mean(obs)
+        noise = mean if deterministic else mean + self.fixed_std * torch.randn_like(mean)
+        noise = noise.clamp(-self.noise_clip, self.noise_clip)
+        return noise, torch.zeros_like(noise), None
+
+    @torch.inference_mode()
+    def predict_action_batch(self, env_obs, calculate_logprobs=True, calculate_values=True, return_obs=True, mode="train", **kwargs):
+        del calculate_logprobs, calculate_values, mode
+        obs = self.preprocess_env_obs(env_obs=env_obs)
+        # sampled in evaluation too: the VLA was trained on N(0, I) noise, a noise-free input is out of distribution
+        noise, logprobs, _ = self.sac_forward(obs, deterministic=False)
+        forward_inputs = {"action": noise, "model_action": noise}
+        if return_obs:
+            forward_inputs.update(obs)
+        result = {
+            "prev_logprobs": logprobs,
+            "prev_values": torch.zeros_like(logprobs[..., :1]),
+            "forward_inputs": forward_inputs,
+        }
+        return self._format_chunk_actions(noise), result
