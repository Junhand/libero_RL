+def _fast_query_hf_dataset(self, query_indices: dict[str, list[int]]) -> dict:
+    """Replacement for ``DatasetReader._query_hf_dataset`` (lerobot 0.6.1).
+
+    The original does ``self.hf_dataset[key][relative_indices]``, which converts the
+    *whole* column to torch tensors for every sample (O(#frames), ~8 s/sample on the
+    1.76M-frame merged dataset). Indexing rows first returns the same tensors in ms.
+    """
+    result: dict = {}
+    for key, q_idx in query_indices.items():
+        if key in self._meta.video_keys:
+            continue
+        relative_indices = (
+            q_idx
+            if self._absolute_to_relative_idx is None
+            else [self._absolute_to_relative_idx[idx] for idx in q_idx]
+        )
+        result[key] = torch.stack(self.hf_dataset[relative_indices][key])
+    return result
+
+
+def _use_fast_hf_query(dataset: Any) -> None:
+    reader = getattr(dataset, "reader", None)
+    if reader is not None and hasattr(reader, "_query_hf_dataset"):
+        reader._query_hf_dataset = types.MethodType(_fast_query_hf_dataset, reader)
+
+
 class SmolVLARecapDataset(Dataset):
