+    def _save_trainable_weights_only(self, save_path: str, step: int) -> None:
+        """Save only the trainable parameters (``<save_path>/model_state_dict/full_weights.pt``).
+
+        Used when the vision encoder AND the language model are frozen: FSDP's full-state-dict hook
+        asserts on the fully frozen SigLIP wrapper (``logit_scale`` missing), and the frozen weights are
+        identical to the pretrained ones that ``get_model`` loads anyway (``strict=False`` load)."""
+        import os
+
+        from torch.distributed.fsdp import FullyShardedDataParallel as FSDP
+
+        state = {}
+        with FSDP.summon_full_params(self.model, writeback=False):
+            for name, parameter in self.model.named_parameters():
+                if not parameter.requires_grad:
+                    continue
+                clean = name
+                for token in ("_fsdp_wrapped_module.", "_checkpoint_wrapped_module.", "_orig_mod."):
+                    clean = clean.replace(token, "")
+                state[clean] = parameter.detach().to("cpu", dtype=torch.float32).clone()
+        if self._rank == 0:
+            out_dir = os.path.join(save_path, "model_state_dict")
+            os.makedirs(out_dir, exist_ok=True)
+            torch.save(state, os.path.join(out_dir, "full_weights.pt"))
+            logging.getLogger(__name__).info(
+                "Saved %d trainable tensors (%.1f MB) at step %d to %s",
+                len(state),
+                sum(t.numel() * 4 for t in state.values()) / 1e6,
+                step,
+                out_dir,
+            )
