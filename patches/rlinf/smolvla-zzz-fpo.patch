+"""SmolVLA for PPO with a Flow-SDE policy (piRL, arXiv:2510.25889), in RLinf's embodied PPO.
+
+Training rollouts denoise with ``num_steps`` Euler steps in which one randomly chosen step is an SDE step; the
+other steps are deterministic, so the Gaussian log-probability of the chosen step is the exact likelihood of the
+sampled action chunk. Per rollout entry we keep the chosen step's input/output samples, the step index, and the
+raw observation. ``default_forward`` recomputes that step's log-probability with the current weights, as
+``rlinf.models.embodiment.openpi.tasks.rl.Pi0RL`` does.
+
+  * ``logprobs``  = Gaussian log-prob of the chosen step, ``[B, num_action_chunks * action_dim]`` (the first
+                    executed steps and real action dims of the ``[chunk_size, max_action_dim]`` sample).
+  * ``values``    = value head over the mean-pooled final-layer prefix and the robot state (as in SmolVLAForFPO).
+Evaluation uses the deterministic ODE (parent class).
+"""
+
+from __future__ import annotations
+
+import random
+from typing import Any, Literal
+
+import torch
+
+from rlinf.models.embodiment.pi0_fast.lerobot_io import build_lerobot_batch_from_env_obs
+from rlinf.models.embodiment.smolvla import sde
+from rlinf.models.embodiment.smolvla.smolvla_fpo_model import SmolVLAForFPO
+
+
+class SmolVLAForFlowSDE(SmolVLAForFPO):
+    def __init__(
+        self, policy, *, noise_level: float = 0.5, num_steps: int | None = None, prefix_bf16: bool = False, **kwargs: Any
+    ) -> None:
+        super().__init__(policy, **kwargs)
+        self.prefix_bf16 = bool(prefix_bf16)
+        self.noise_level = float(noise_level)
+        if num_steps is not None:
+            # The number of Euler steps is shared by training rollouts and (deterministic) evaluation.
+            self.policy.config.num_steps = int(num_steps)
+        self.denoise_steps = int(self.policy.config.num_steps)
+
+    def _logprob_slice(self, logprob: torch.Tensor) -> torch.Tensor:
+        return logprob[:, : self.num_action_chunks, : self.action_dim]
+
+    def _step_logprob(self, prefix_pad_masks, past_key_values, x_prev, x_next, idx):
+        """Velocity at ``x_prev`` for step ``idx`` ([B] long) -> Gaussian log-prob of ``x_next``."""
+        timesteps = sde.get_timesteps(self.denoise_steps, x_prev.device)
+        t = timesteps[idx].to(torch.float32)
+        v_t = self.policy.model.denoise_step(prefix_pad_masks, past_key_values, x_prev, t).to(torch.float32)
+        mean, std = sde.sample_mean_std(
+            x_prev, v_t, idx, sde=True, noise_level=self.noise_level, num_steps=self.denoise_steps
+        )
+        return sde.gaussian_logprob(x_next, mean, std)
+
+    @torch.no_grad()
+    def predict_action_batch(
+        self,
+        env_obs: dict[str, Any],
+        mode: Literal["train", "eval"] = "train",
+        **kwargs: Any,
+    ) -> tuple[torch.Tensor, dict[str, Any]]:
+        if mode == "eval" and not self.prefix_bf16:
+            return super(SmolVLAForFPO, self).predict_action_batch(env_obs, mode=mode, **kwargs)
+        from lerobot.utils.constants import (
+            OBS_LANGUAGE_ATTENTION_MASK,
+            OBS_LANGUAGE_TOKENS,
+        )
+
+        batch = build_lerobot_batch_from_env_obs(env_obs, image_size=self.image_size)
+        batch = self._prepare_lerobot_batch(batch)
+        config = self.policy.config
+        chunk, max_dim = int(config.chunk_size), int(config.max_action_dim)
+        images, img_masks, lang_tokens, lang_masks, state = self._model_inputs(batch)
+        features, prefix_pad_masks, past_key_values = sde.prefix_cache(
+            self.policy.model, images, img_masks, lang_tokens, lang_masks, state, bf16=self.prefix_bf16
+        )
+        batch_size, device = state.shape[0], state.device
+        steps = self.denoise_steps
+        timesteps = sde.get_timesteps(steps, device)
+        chosen = random.randint(0, steps - 1)  # one stochastic step per rollout call, as in Pi0RL
+
+        eval_mode = mode == "eval"  # deterministic ODE with the same prefix precision as training
+        noise = self._sample_noise(batch) if eval_mode else None
+        x = noise if noise is not None else torch.randn(batch_size, chunk, max_dim, device=device, dtype=torch.float32)
+        x_prev = x_next = logprob = None
+        for step in range(steps):
+            idx = torch.full((batch_size,), step, device=device, dtype=torch.long)
+            t = torch.full((batch_size,), float(timesteps[step]), device=device, dtype=torch.float32)
+            v_t = self.policy.model.denoise_step(prefix_pad_masks, past_key_values, x, t).to(torch.float32)
+            mean, std = sde.sample_mean_std(
+                x, v_t, idx, sde=(step == chosen) and not eval_mode, noise_level=self.noise_level, num_steps=steps
+            )
+            new_x = mean + torch.randn_like(x) * std
+            if step == chosen:
+                x_prev, x_next = x, new_x
+                logprob = self._logprob_slice(sde.gaussian_logprob(new_x, mean, std))
+            x = new_x
+
+        actions = x[:, : self.num_action_chunks, : self.action_dim].float().cpu()
+        if self.postprocessor is not None:
+            actions = self.postprocessor(actions)
+        if eval_mode:
+            return actions, {"prev_logprobs": None, "prev_values": None, "forward_inputs": {}}
+        prev_values = self._value(features, batch).reshape(batch_size, 1).cpu()
+        forward_inputs = {
+            "main_images": env_obs["main_images"].cpu(),
+            "wrist_images": env_obs["wrist_images"].cpu(),
+            "states": env_obs["states"].float().cpu(),
+            "lang_tokens": batch[OBS_LANGUAGE_TOKENS].cpu(),
+            "lang_masks": batch[OBS_LANGUAGE_ATTENTION_MASK].cpu(),
+            "sde_x_prev": x_prev.cpu(),
+            "sde_x_next": x_next.cpu(),
+            "sde_step": torch.full((batch_size,), chosen, dtype=torch.long),
+            "action": actions.reshape(batch_size, -1).float(),
+        }
+        return actions, {
+            "prev_logprobs": logprob.reshape(batch_size, -1).float().cpu(),
+            "prev_values": prev_values,
+            "forward_inputs": forward_inputs,
+        }
+
+    def default_forward(self, forward_inputs: dict[str, torch.Tensor], **kwargs: Any) -> dict[str, torch.Tensor]:
+        """Recompute the chosen step's log-probability and the value for the stored rollout."""
+        from lerobot.utils.constants import (
+            OBS_LANGUAGE_ATTENTION_MASK,
+            OBS_LANGUAGE_TOKENS,
+        )
+
+        device = next(self.parameters()).device
+        batch_size = forward_inputs["states"].shape[0]
+        obs = {
+            "main_images": forward_inputs["main_images"],
+            "wrist_images": forward_inputs["wrist_images"],
+            "states": forward_inputs["states"],
+            "task_descriptions": [""] * batch_size,  # tokens are restored from the rollout below
+        }
+        batch = self._prepare_lerobot_batch(build_lerobot_batch_from_env_obs(obs, image_size=self.image_size))
+        batch[OBS_LANGUAGE_TOKENS] = forward_inputs["lang_tokens"].to(device)
+        batch[OBS_LANGUAGE_ATTENTION_MASK] = forward_inputs["lang_masks"].to(device)
+        images, img_masks, lang_tokens, lang_masks, state = self._model_inputs(batch)
+        features, prefix_pad_masks, past_key_values = sde.prefix_cache(
+            self.policy.model, images, img_masks, lang_tokens, lang_masks, state, bf16=self.prefix_bf16
+        )
+        logprob = self._step_logprob(
+            prefix_pad_masks,
+            past_key_values,
+            forward_inputs["sde_x_prev"].to(device).float(),
+            forward_inputs["sde_x_next"].to(device).float(),
+            forward_inputs["sde_step"].to(device).long(),
+        )
+        return {
+            "logprobs": self._logprob_slice(logprob).reshape(batch_size, -1).float(),
+            "values": self._value(features, batch),
+            "entropy": torch.zeros(batch_size, 1, device=device, dtype=torch.float32),
+        }
