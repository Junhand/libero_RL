@@ -0,0 +1,179 @@
+# Vanilla Flow Policy Optimization (FPO, arXiv:2507.21053) for SmolVLA on LIBERO-10 Task 0.
+# PPO with the conditional flow-matching loss of N fixed (time, noise) samples as the log-likelihood (see
+# rlinf/models/embodiment/smolvla/smolvla_fpo_model.py and docs/fpo_smolvla_design.md).
+#   bash: cd tmp/rlinf_dev; python examples/embodiment/train_embodied_agent.py --config-name libero_10_smolvla_fpo \
+#     actor.model.model_path=/path/to/smolvla_libero actor.model.smolvla.vlm_model_name=/path/to/SmolVLM2-500M-Video-Instruct
+defaults:
+  - env/libero_10@env.train
+  - env/libero_10@env.eval
+  - hybrid_engines/fsdp@actor.fsdp_config
+  - weight_syncer/patch_syncer@weight_syncer
+  - override hydra/job_logging: stdout
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+  searchpath:
+    - file://${oc.env:EMBODIED_PATH}/config/
+
+cluster:
+  num_nodes: 1
+  component_placement:
+    actor,env,rollout: all
+
+runner:
+  task_type: embodied
+  logger:
+    log_path: "../results"
+    project_name: rlinf
+    experiment_name: "libero_10_smolvla_fpo"
+    logger_backends: ["tensorboard"]
+
+  max_epochs: 40 # number of PPO updates
+  max_steps: -1
+  only_eval: False
+  val_check_interval: -1
+  save_interval: 5
+  resume_dir: null
+  ckpt_path: null
+
+algorithm:
+  normalize_advantages: True
+  group_size: 1
+  reward_coef: 1.0
+
+  reward_type: chunk_level
+  logprob_type: token_level   # ratio per (action step, CFM sample), as in FPO
+  logprob_last_dim: 1         # one chunk-level log-ratio per action chunk
+  entropy_type: token_level
+  update_epoch: 2
+  target_kl: 0.1               # stop the remaining update epochs when the mean epoch KL (k3) exceeds this
+  adv_type: gae
+  loss_type: actor_critic
+  loss_agg_func: "token-mean"
+  kl_beta: 0.0
+  entropy_bonus: 0
+  clip_ratio_high: 0.01       # FPO clip radius
+  clip_ratio_low: 0.01
+  clip_ratio_c: null
+  value_clip: 1000.0          # effectively no value clipping (FPO has none)
+  huber_delta: 10.0
+
+  gamma: 0.951                # 0.995 ** 10 (per action chunk of 10 environment steps)
+  gae_lambda: 0.99
+
+  filter_rewards: False
+
+env:
+  group_name: "EnvGroup"
+  train:
+    task_id_filter: [0]
+    rollout_epoch: 5          # episodes per environment per update
+    total_num_envs: 3
+    seed: 2026
+    auto_reset: False
+    ignore_terminations: False
+    use_fixed_reset_state_ids: False
+    use_ordered_reset_state_ids: False
+    use_rel_reward: False
+    reward_coef: ${algorithm.reward_coef}
+    max_episode_steps: 520
+    max_steps_per_rollout_epoch: 520
+    group_size: 1
+    skip_intermediate_renders: True
+    video_cfg:
+      save_video: False
+  eval:
+    task_id_filter: [0]
+    rollout_epoch: 1
+    total_num_envs: 2
+    seed: 2026
+    auto_reset: True
+    ignore_terminations: True
+    use_rel_reward: False
+    reward_coef: 1.0
+    max_episode_steps: 520
+    max_steps_per_rollout_epoch: 13000
+    group_size: 1
+    use_fixed_reset_state_ids: True
+    is_eval: True
+    video_cfg:
+      save_video: False
+
+rollout:
+  group_name: "RolloutGroup"
+  generation_backend: "huggingface"
+  recompute_logprobs: False
+  enable_offload: False
+  pipeline_stage_num: 1
+  collect_prev_infos: True
+
+  model:
+    model_type: ${actor.model.model_type}
+    model_path: ${actor.model.model_path}
+    precision: ${actor.model.precision}
+    add_value_head: ${actor.model.add_value_head}
+    action_dim: ${actor.model.action_dim}
+    num_action_chunks: ${actor.model.num_action_chunks}
+    is_lora: False
+    smolvla: ${actor.model.smolvla}
+
+actor:
+  group_name: "ActorGroup"
+  training_backend: "fsdp"
+  micro_batch_size: 10
+  global_batch_size: 130      # rollout entries per update (52 chunk steps x 3 envs x 5 epochs = 780) must be divisible by this
+  seed: 1234
+  enable_offload: False
+
+  model:
+    model_type: "smolvla"
+    model_path: "/path/to/smolvla_libero"
+    precision: fp32
+    add_value_head: True        # required by loss_type actor_critic; the value head itself lives in SmolVLAForFPO
+    action_dim: 7
+    num_action_chunks: 10
+    is_lora: False
+    smolvla:
+      vlm_model_name: "/path/to/SmolVLM2-500M-Video-Instruct"
+      noise_seed: null          # random initial flow noise: the exploration of FPO
+      chunk_size: 50
+      advantage_prompt: False
+      rename_map:
+        observation.images.image: observation.images.camera1
+        observation.images.image2: observation.images.camera2
+      fpo:
+        enabled: True
+        n_action_samples: 4
+        value_hidden_dims: [512, 256]
+        state_dim: 8
+
+  optim:
+    lr: 1.0e-5
+    value_lr: 1.0e-4
+    adam_beta1: 0.9
+    adam_beta2: 0.99
+    adam_eps: 1.0e-08
+    weight_decay: 0.0
+    clip_grad: 25.0
+    critic_warmup_steps: 12     # optimizer steps of the first update (value only): 6 mini-batches x 2 epochs
+    total_training_steps: 40
+    min_lr_rate: 1.0
+    lr_scheduler: "constant"
+
+  fsdp_config:
+    strategy: "fsdp"
+    sharding_strategy: "no_shard"
+    use_orig_params: True       # frozen (VLM) and trainable (expert, value head) parameters share FSDP units
+    gradient_checkpointing: False
+    mixed_precision:
+      param_dtype: ${actor.model.precision}
+      reduce_dtype: ${actor.model.precision}
+      buffer_dtype: ${actor.model.precision}
+
+reward:
+  use_reward_model: False
+
+critic:
+  use_critic_model: False
