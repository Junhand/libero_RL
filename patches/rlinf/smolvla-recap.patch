+++ b/evaluations/libero/libero_10_smolvla_collect.yaml
@@ -0,0 +1,87 @@
+# Collect LIBERO-10 Task 0 rollouts with a LeRobot SmolVLA policy, for RECAP Steps 1-3.
+#
+# Extends libero_10_smolvla_eval.yaml with env.eval.data_collection (lerobot format). The eval reset
+# pool cycles over Task 0's fixed init states (env.eval.use_ordered_reset_state_ids), and SmolVLA's
+# flow-matching sampling is stochastic, so repeated passes over the same ~50 init states still yield
+# varied trajectories with a mix of successes and failures — the same shape as
+# RLinf/RECAP-Libero10-Task0-48succ-Data's libero10_task0_train / libero10_task0_eval.
+#
+# rollout_epoch controls how many trajectories are collected: with total_num_envs=E init states run
+# in parallel and N = max_steps_per_rollout_epoch / max_episode_steps passes per epoch, one epoch
+# yields roughly rollout_epoch * N * E episodes (exact count depends on how many envs still have a
+# trajectory in flight when the run ends; see scripts/convert_rlinf_collected_to_v21.py --max-episodes
+# to trim to an exact count).
+#
+# Usage (from RLinf/):
+#   bash evaluations/run_eval.sh libero libero_10_smolvla_collect \
+#     rollout.model.model_path=/path/to/smolvla_libero_plus \
+#     env.eval.data_collection.save_dir=/path/to/save/rollout_dir
+# Task 0 sft-sized eval split (~64 episodes): add env.eval.rollout_epoch=2 (2*50=100, trim to 64).
+# Task 0 train split (~4096 episodes): env.eval.rollout_epoch=82 (82*50=4100, trim to 4096).
+
+defaults:
+  - env/libero_10@env.eval
+  - model/smolvla@rollout.model
+  - override hydra/job_logging: stdout
+
+hydra:
+  run:
+    dir: .
+  output_subdir: null
+  searchpath:
+    - file://${oc.env:EMBODIED_PATH}/config/
+
+cluster:
+  num_nodes: 1
+  component_placement:
+    env,rollout: all
+
+runner:
+  task_type: embodied_eval
+  logger:
+    log_path: "../results"
+    project_name: rlinf
+    experiment_name: "libero_10_smolvla_collect"
+    logger_backends: ["tensorboard"]
+
+  max_epochs: 1
+  max_steps: -1
+  only_eval: True
+  val_check_interval: -1
+  save_interval: -1
+  resume_dir: null
+  ckpt_path: null
+
+env:
+  group_name: "EnvGroup"
+  eval:
+    task_id_filter: [0]
+    rollout_epoch: 82 # override per split, see header
+    total_num_envs: 50 # Task 0's number of fixed init states
+    auto_reset: True
+    ignore_terminations: True
+    use_fixed_reset_state_ids: True
+    use_ordered_reset_state_ids: True
+    max_episode_steps: 520
+    max_steps_per_rollout_epoch: 520 # N=1 pass per epoch; raise to collect more per epoch
+    group_size: 1
+    is_eval: True
+    video_cfg:
+      save_video: False
+    data_collection:
+      enabled: True
+      save_dir: "/path/to/save/rollout_dir"
+      export_format: "lerobot"
+      only_success: False
+      robot_type: "panda"
+      fps: 10
+
+rollout:
+  group_name: "RolloutGroup"
+  generation_backend: "huggingface"
+  recompute_logprobs: False
+  enable_offload: False
+  pipeline_stage_num: 1
+
+  model:
+    model_path: "/path/to/smolvla_libero_plus"
