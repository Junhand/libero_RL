diff --git a/rlinf/data/datasets/recap/smolvla_cfg.py b/rlinf/data/datasets/recap/smolvla_cfg.py
new file mode 100644
index 00000000..31eea532
--- /dev/null
+++ b/rlinf/data/datasets/recap/smolvla_cfg.py
@@ -0,0 +1,204 @@
+# Copyright 2026 The RLinf Authors.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     https://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Advantage-conditioned (RECAP) SFT data for LeRobot SmolVLA.
+
+RLinf's CFG model (``cfg_model.py``) conditions pi0.5 on the prompt
+``"{task}\\nAdvantage: positive"``. With ``positive_only_conditional`` and
+``cfgrl_guidance_scale=1.0`` this reduces to supervised training where
+positive-advantage frames use the conditional prompt (dropped to the plain task
+with probability ``unconditional_prob``) and negative frames always use the
+plain task. This module builds that data for SmolVLA from LeRobot v3.0 datasets
+and the ``meta/advantages_{tag}.parquet`` files written by RECAP Step 3.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import torch
+from omegaconf import DictConfig, OmegaConf
+from torch.utils.data import ConcatDataset, DataLoader, Dataset, Sampler
+
+from rlinf.models.embodiment.smolvla.smolvla_action_model import (
+    ADVANTAGE_PROMPT_SUFFIX,
+)
+
+# RLinf RECAP datasets (libero10_task0_*) -> lerobot/libero keys.
+DEFAULT_KEY_MAP = {
+    "image": "observation.images.image",
+    "wrist_image": "observation.images.image2",
+    "state": "observation.state",
+    "actions": "action",
+}
+
+
+class SmolVLARecapDataset(Dataset):
+    """One LeRobot v3.0 dataset with per-frame advantage labels."""
+
+    def __init__(
+        self,
+        dataset_path: str,
+        advantages_path: str,
+        chunk_size: int,
+        key_map: dict[str, str],
+        unconditional_prob: float,
+        prompt_suffix: str,
+        video_backend: str | None = None,
+    ) -> None:
+        from lerobot.datasets.lerobot_dataset import LeRobotDataset
+
+        root = Path(dataset_path)
+        action_key = next(src for src, dst in key_map.items() if dst == "action")
+        probe = LeRobotDataset(f"local/{root.name}", root=root, video_backend=video_backend)
+        fps = probe.meta.fps
+        self.dataset = LeRobotDataset(
+            f"local/{root.name}",
+            root=root,
+            delta_timestamps={action_key: [i / fps for i in range(chunk_size)]},
+            video_backend=video_backend,
+        )
+        self.key_map = dict(key_map)
+        self.key_map[f"{action_key}_is_pad"] = "action_is_pad"
+        self.unconditional_prob = float(unconditional_prob)
+        self.prompt_suffix = prompt_suffix
+
+        adv = pd.read_parquet(
+            advantages_path, columns=["episode_index", "frame_index", "advantage"]
+        )
+        lookup = dict(
+            zip(zip(adv.episode_index, adv.frame_index), adv.advantage.astype(bool))
+        )
+        rows = self.dataset.hf_dataset.select_columns(["episode_index", "frame_index"])
+        episode_index = np.asarray(rows["episode_index"]).reshape(-1)
+        frame_index = np.asarray(rows["frame_index"]).reshape(-1)
+        missing = [
+            (int(e), int(f))
+            for e, f in zip(episode_index, frame_index)
+            if (int(e), int(f)) not in lookup
+        ]
+        if missing:
+            raise ValueError(
+                f"{len(missing)} frames of {root} have no advantage label in "
+                f"{advantages_path} (first: {missing[:5]}). Re-run RECAP Step 3 on "
+                "this dataset."
+            )
+        self.advantage = np.array(
+            [lookup[(int(e), int(f))] for e, f in zip(episode_index, frame_index)],
+            dtype=bool,
+        )
+
+    def __len__(self) -> int:
+        return len(self.dataset)
+
+    def __getitem__(self, idx: int) -> dict[str, Any]:
+        item = self.dataset[idx]
+        sample = {dst: item[src] for src, dst in self.key_map.items()}
+        task = item["task"]
+        # Re-sampled every time, like RLinf's per-step unconditional dropout.
+        if self.advantage[idx] and torch.rand(()).item() >= self.unconditional_prob:
+            task = task + self.prompt_suffix
+        sample["task"] = task
+        return sample
+
+
+class WeightedDistributedSampler(Sampler[int]):
+    """Sample with replacement by per-item weight, sharded across ranks."""
+
+    def __init__(
+        self, weights: torch.Tensor, num_replicas: int, rank: int, seed: int = 0
+    ) -> None:
+        self.weights = weights
+        self.num_replicas = num_replicas
+        self.rank = rank
+        self.seed = seed
+        self.epoch = 0
+        self.num_samples = len(weights) // num_replicas
+
+    def set_epoch(self, epoch: int) -> None:
+        self.epoch = epoch
+
+    def __iter__(self):
+        generator = torch.Generator().manual_seed(self.seed + self.epoch)
+        indices = torch.multinomial(
+            self.weights,
+            self.num_samples * self.num_replicas,
+            replacement=True,
+            generator=generator,
+        )
+        return iter(indices[self.rank :: self.num_replicas].tolist())
+
+    def __len__(self) -> int:
+        return self.num_samples
+
+
+def build_smolvla_recap_sft_dataloader(
+    cfg: DictConfig, world_size: int, global_rank: int, data_paths: Any
+):
+    """Build the RECAP SFT dataloader for SmolVLA.
+
+    ``data.train_data_paths`` entries: ``dataset_path`` (LeRobot v3.0 root),
+    ``advantages_path`` (RECAP Step 3 parquet) and optional ``weight``.
+    """
+    data_cfg = cfg.data
+    model_cfg = cfg.actor.model
+    smolvla_cfg = model_cfg.get("smolvla", {}) or {}
+    key_map = data_cfg.get("key_map")
+    key_map = (
+        OmegaConf.to_container(key_map, resolve=True) if key_map else DEFAULT_KEY_MAP
+    )
+
+    datasets, weights = [], []
+    for entry in data_paths:
+        dataset = SmolVLARecapDataset(
+            dataset_path=entry["dataset_path"],
+            advantages_path=entry["advantages_path"],
+            chunk_size=int(smolvla_cfg.get("chunk_size", 50)),
+            key_map=key_map,
+            unconditional_prob=float(data_cfg.get("unconditional_prob", 0.1)),
+            prompt_suffix=ADVANTAGE_PROMPT_SUFFIX,
+            video_backend=data_cfg.get("video_backend", None),
+        )
+        weight = float(entry.get("weight", 1.0))
+        if data_cfg.get("balance_dataset_weights", True):
+            # Each dataset contributes by its weight regardless of its size.
+            weight = weight / len(dataset)
+        datasets.append(dataset)
+        weights.append(torch.full((len(dataset),), weight, dtype=torch.double))
+        if global_rank == 0:
+            print(
+                f"[smolvla recap] {entry['dataset_path']}: {len(dataset)} frames, "
+                f"positive {dataset.advantage.mean():.1%}"
+            )
+
+    sampler = WeightedDistributedSampler(
+        torch.cat(weights),
+        num_replicas=world_size,
+        rank=global_rank,
+        seed=int(data_cfg.get("seed", 42)),
+    )
+    num_workers = int(data_cfg.get("num_workers", 4))
+    data_loader = DataLoader(
+        ConcatDataset(datasets),
+        batch_size=cfg.actor.micro_batch_size,
+        sampler=sampler,
+        num_workers=num_workers,
+        pin_memory=True,
+        drop_last=True,
+        persistent_workers=num_workers > 0,
+    )
+    return data_loader, {}
