+    def _load_base_sample(self, idx: int) -> tuple[dict[str, Any], int]:
+        """Load self._base[real_idx], retrying with the next sample on decode errors.
+
+        Video files occasionally fail to decode (corrupt frame, transient
+        filesystem glitch). Rather than crashing the whole training run on one
+        bad sample, log full details (dataset, indices, offending video path)
+        and retry with a different sample so training can continue.
