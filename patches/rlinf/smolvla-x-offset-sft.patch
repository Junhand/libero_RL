+    def _forward_actor_offset_sft(self, batch, pi, log_pi, curr_obs, reference_dropout_prob):
+        """Critic-free actor loss: BC to the VLA reference + SFT on the executed chunks whose
+        temporal-offset score (stored in ``rewards`` at ingestion) is in the top fraction of the batch."""
+        cfg = self._offset_cfg()
+        chunk_len, action_dim = self._chunk_shape()
+        ref_chunk = self._ref_chunk(curr_obs)
+        bc_loss, metrics = self._bc_metrics(
+            pi=pi, actions=batch["actions"], ref_chunk=ref_chunk,
+            intervene_flags=batch.get("intervene_flags", None),
+        )
+        bc_weight, _, weight_metrics = self._actor_objective_weights()
+        metrics.update(weight_metrics)
+        in_warmup = bool(weight_metrics.get("actor_weight_in_warmup", 0.0))
+        sft_weight = 0.0 if in_warmup else float(cfg.get("sft_weight", 1.0))
+
+        pi_chunk = self._flatten_chunk(pi).reshape(-1, chunk_len, action_dim)
+        executed = self._flatten_chunk(batch["actions"]).reshape(-1, chunk_len, action_dim).to(pi_chunk.dtype)
+        score = batch["rewards"].reshape(pi_chunk.shape[0], -1).float().mean(dim=1)
+        thr = torch.quantile(score, 1.0 - float(cfg.get("top_fraction", 0.3)))
+        mask = (score >= thr).to(pi_chunk.dtype)
+        err = torch.mean(torch.square(pi_chunk - executed), dim=(1, 2))
+        sft_loss = torch.sum(err * mask) / torch.clamp(torch.sum(mask), min=1.0)
+        actor_loss = bc_weight * bc_loss + sft_weight * sft_loss
+        metrics.update({
+            "sft_loss": sft_loss.detach().item(),
+            "sft_weight": sft_weight,
+            "sft_score_mean": score.mean().item(),
+            "sft_score_thr": thr.item(),
+            "sft_positive_rate": mask.mean().item(),
+            "weighted_bc": (bc_weight * bc_loss).detach().item(),
+            "reference_dropout_prob": reference_dropout_prob,
+            "action_ref_abs_mean": (self._flatten_chunk(pi) - self._flatten_chunk(ref_chunk)).abs().mean().detach().item(),
+        })
+        return actor_loss, -log_pi.mean(), metrics
+
