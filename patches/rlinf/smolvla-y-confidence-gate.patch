+
+"""Confidence gate for the RLT actor: use the actor only where the RL token is close to known-good states.
+
+The reference set is a matrix of standardized RL tokens (``{"z", "mu", "sd"}`` in a ``.pt`` file). The confidence of a
+chunk is the distance of its RL token to the k-th nearest reference token (smaller = more familiar). Where the
+distance exceeds ``threshold`` the route falls back to the VLA reference chunk.
+"""
+
+import json
+import os
+
+import torch
+
+
+class KNNConfidenceGate:
+    def __init__(self, ref_path: str, k: int, threshold: float, log_path: str | None = None):
+        ref = torch.load(ref_path, map_location="cpu", weights_only=False)
+        self.z = torch.as_tensor(ref["z"], dtype=torch.float32)
+        self.mu = torch.as_tensor(ref["mu"], dtype=torch.float32)
+        self.sd = torch.as_tensor(ref["sd"], dtype=torch.float32)
+        self.k = int(k)
+        self.threshold = float(threshold)
+        self.log_path = log_path
+        self._device = None
+
+    def _to(self, device: torch.device) -> None:
+        if self._device != device:
+            self.z, self.mu, self.sd = self.z.to(device), self.mu.to(device), self.sd.to(device)
+            self._device = device
+
+    @torch.no_grad()
+    def distance(self, z_rl: torch.Tensor) -> torch.Tensor:
+        self._to(z_rl.device)
+        q = (z_rl.float().reshape(z_rl.shape[0], -1) - self.mu) / self.sd
+        d = torch.cdist(q, self.z)
+        return d.topk(self.k, dim=1, largest=False).values[:, -1]
+
+    @torch.no_grad()
+    def __call__(self, z_rl: torch.Tensor, active: torch.Tensor | None = None) -> torch.Tensor:
+        """Bool [B]: True where the actor may act. ``active`` (bool [B]) only marks which rows are logged."""
+        dist = self.distance(z_rl)
+        confident = dist <= self.threshold
+        if self.log_path:
+            rows = {
+                "dist": [round(float(x), 4) for x in dist.cpu()],
+                "confident": [bool(x) for x in confident.cpu()],
+                "active": None if active is None else [bool(x) for x in active.cpu()],
+            }
+            os.makedirs(os.path.dirname(self.log_path) or ".", exist_ok=True)
+            with open(self.log_path, "a") as f:
+                f.write(json.dumps(rows) + "\n")
+        return confident
