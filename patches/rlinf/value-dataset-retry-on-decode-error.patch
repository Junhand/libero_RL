+                    real_idx,
+                    self._describe_load_failure(real_idx),
+                    attempt + 1,
+                    self._MAX_LOAD_RETRIES,
+                    exc,
+                    exc_info=True,
+                )
+                cur_idx = (cur_idx + 1) % n
+        raise RuntimeError(
+            f"ValueDataset: failed to load a valid sample after "
+            f"{self._MAX_LOAD_RETRIES} attempts starting at idx={idx} "
